{
  "name": "vscode-operate-from-autohotkey",
  "displayName": "Operate VSCode from AutoHotkey",
  "version": "2.0.0",
  "description": "Provides a way to execute VSCode commands from AutoHotkey. Also provides command to get context information (e.g. caret position).",
  "author": "zero-plusplus <git@zero-plusplus.com>",
  "license": "MIT",
  "repository": "https://github.com/zero-plusplus/vscode-operate-from-autohotkey.git",
  "bugs": "https://github.com/zero-plusplus/vscode-operate-from-autohotkey/issues",
  "main": "./build/extension",
  "scripts": {
    "build": "ts-node scripts/bin/build.ts",
    "clean": "ts-node scripts/bin/clean.ts",
    "watch": "ts-node scripts/bin/watch.ts",
    "watch:public": "ts-node scripts/bin/watch.public.ts",
    "lint": "ts-node scripts/bin/lint.ts",
    "sandbox": "ts-node scripts/bin/sandbox.ts",
    "test": "jest --runInBand --detectOpenHandles",
    "test:sandbox": "ts-node scripts/bin/sandbox.ts",
    "package": "ts-node scripts/bin/package.ts"
  },
  "publisher": "zero-plusplus",
  "keywords": [
    "autohotkey"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.86.0"
  },
  "icon": "icon.png",
  "contributes": {
    "configuration": {
      "properties": {
        "operate-from-autohotkey.allowCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Allowed command names. Can be used as a wildcard by adding a trailing \"*\". By default, all commands are allowed.",
          "default": [
            "*"
          ]
        },
        "operate-from-autohotkey.hideError": {
          "type": "boolean",
          "description": "Whether to notify the user of an error when a command fails to execute.",
          "default": false
        },
        "operate-from-autohotkey.repeatLimit": {
          "type": "number",
          "description": "Maximum number of times a command can be repeated at one time.",
          "default": 100
        },
        "operate-from-autohotkey.communicationStrategy": {
          "type": "string",
          "description": "How to use it for communication.",
          "enum": [
            "clipboard",
            "server"
          ],
          "default": "clipboard"
        }
      }
    },
    "keybindings": [
      {
        "key": "shift+ctrl+alt+f12",
        "command": "operate-from-autohotkey.executeCommand"
      }
    ]
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.86.0",
    "@vscode/vsce": "^2.25.0",
    "@zero-plusplus/eslint-my-rules": "github:zero-plusplus/eslint-my-rules",
    "del": "^6.1.1",
    "esbuild": "^0.20.2",
    "fs-extra": "^11.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "type-fest": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
